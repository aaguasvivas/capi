# Capi mobile (apps/mobile). Copy to apps/mobile/.env (gitignored) and fill in the values.
# EAS builds do not read this file; the same names live in EAS env vars per build profile.

# Supabase (required): live game state and quick chat. Read by lib/supabase.ts.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. API origin for create/join/move; defaults to https://playcapi.com (theme.ts).
# Leave it unset for production. Uncomment with your LAN address to test against a local web dev server.
# EXPO_PUBLIC_API_BASE=http://192.168.1.10:3000
