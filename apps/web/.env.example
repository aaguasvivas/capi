# Capi web (apps/web). Copy to apps/web/.env.local (gitignored) and fill in the values.
# On Vercel the same names live in the project's environment variables.

# Supabase (required). The browser client and the API routes read these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server only, never exposed to the browser. Recommended: the API prefers it over the anon key when set.
# SUPABASE_SERVICE_ROLE_KEY=

# Resend (optional). Bug reports are always saved to the database; the email is sent only when the key is set.
# RESEND_API_KEY=
# Optional sender for bug-report emails; defaults to the Resend sandbox address in src/app/api/bug-reports/route.ts.
# RESEND_FROM_EMAIL=

# Sentry (all optional). With no DSN set, next.config.js skips the Sentry wrapper and local dev needs no Sentry auth.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Source map upload during `next build`; Vercel's Sentry integration fills these in.
# SENTRY_ORG=
# SENTRY_PROJECT=

# Set by Vercel and Next automatically, never here: VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV, NEXT_RUNTIME, CI.
